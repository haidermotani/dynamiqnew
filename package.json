{
  "name": "dynamiq-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:assets && vite",
    "build": "npm run build:assets && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "build:assets": "node scripts/build-assets.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run build && npm run check:placeholders && npm run verify"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^24.32.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
